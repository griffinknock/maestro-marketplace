# ─────────────────────────────────────────────────────────────────────────
#  Ghostty — Maestro setup
#  Put this at  ~/.config/ghostty/config  and keep it in git. That is the
#  whole point: your terminal's appearance becomes a reviewable file that
#  nothing can silently reset.
#
#  Reload after editing:  cmd+shift+,     Check for mistakes:  ghostty +validate-config
#  Browse every bundled theme:            ghostty +list-themes
#  (arrow keys preview live; the name in the left column is what goes below)
# ─────────────────────────────────────────────────────────────────────────

# ── Theme ────────────────────────────────────────────────────────────────
# Follows macOS appearance automatically. Catppuccin is the cute one, and it
# is the only major family with a genuinely good light variant, which matters
# because your flow maps are light.
#
# Names are title-case with spaces, exactly as `ghostty +list-themes` prints
# them. A name that does not resolve is SILENTLY IGNORED — you get the default
# theme and no error, so if nothing changes, that is the first thing to check.
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Alternatives — soft and pink-leaning:
#   theme = dark:Rose Pine,light:Rose Pine Dawn
# For anything else, run `ghostty +list-themes`, arrow through the previews,
# and copy the name from the left column verbatim.

# ── Type ─────────────────────────────────────────────────────────────────
# Pick one you actually have: `ghostty +list-fonts`. Both of these ship with
# most dev setups; the fallback chain means a missing one is harmless.
font-family = "JetBrainsMono Nerd Font"
font-family = "SF Mono"
font-family = "Menlo"
font-size = 13.5

# Ligatures on for arrows and comparisons. If they bother you: font-feature = -calt
font-feature = calt
font-feature = liga
font-thicken = true

# Maestro's agent tree draws box characters. A hair of extra line height keeps
# the vertical rules continuous instead of dotted.
adjust-cell-height = 8%

# ── Window ───────────────────────────────────────────────────────────────
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-save-state = always
window-colorspace = display-p3

macos-titlebar-style = tabs
macos-option-as-alt = true

# A little depth. Set background-opacity to 1 if you find it distracting.
background-opacity = 0.97
background-blur = 20

# Dim the split you are not looking at — useful when you are watching two
# Claude sessions side by side and need to know which one has focus.
unfocused-split-opacity = 0.88

# ── Cursor ───────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Shell integration ────────────────────────────────────────────────────
# This is what gives you Warp's "blocks" behaviour: every prompt gets a mark,
# so cmd+shift+up / cmd+shift+down jump between commands, and a finished
# command in a background tab can raise a notification.
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ── Behaviour ────────────────────────────────────────────────────────────
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = true
link-url = true
scrollback-limit = 100000

# ── Quick terminal ───────────────────────────────────────────────────────
# A drop-down terminal over whatever you are doing. Good for a fast
# `git worktree list` without leaving the app you are in.
quick-terminal-position = top
quick-terminal-animation-duration = 0.12
keybind = global:cmd+grave_accent=toggle_quick_terminal

# ── Maestro shortcuts ────────────────────────────────────────────────────
# `text:` types the command into the focused terminal, so these behave like
# macros rather than menu items. Remove the trailing \n to review before running.
keybind = cmd+shift+b=text:open http://127.0.0.1:7717/\n
keybind = cmd+shift+a=text:claude agents\n
keybind = cmd+shift+t=text:/tree\n

# Splits. Ghostty's own, not tmux — Maestro nests with subagents rather than
# agent teams, so you never need a multiplexer for this.
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# Dump the whole scrollback to a file and open it — handy when an agent
# printed more than the terminal kept.
keybind = cmd+shift+s=write_scrollback_file:open

# Name a tab. The title you type overrides whatever the shell sets and sticks,
# which is the only way to tell four Claude sessions apart at a glance.
# (Ghostty has no per-tab colour and no left-side tab bar — see README.)
keybind = cmd+i=prompt_tab_title

# Built in already, listed so you remember they exist:
#   cmd+shift+p        command palette
#   cmd+shift+up/down  jump to previous / next prompt
#   cmd+f              search scrollback
#   cmd+shift+,        reload this file
